@import "../../styles/main.less";

@-webkit-keyframes swipe-right {
  from {
    left: 0;
    width: 0;
  }
  to {
    left: ~"calc(100% - 12.5%)";
    width: 12.5%;
  }
}

#swiper {
  position: absolute;
  bottom: 0;
  left: 0;
  height: ((@grid-rows - @ready-board-grid-rows) * @grid-item-height) + 2px;
  border-right: 2px solid #fa7f03;
  background: linear-gradient(90deg, rgba(250, 127, 3, 0) 0%, rgba(250, 127, 3, 0.35) 100%);
  width: 0;
  //-webkit-animation: swipe-right 6s linear 0s infinite;
}